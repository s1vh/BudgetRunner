{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --production=false",
  "crons": [
    {
      "path": "/api/v1/internal/jobs/close-due-periods",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/internal/jobs/rotate-store",
      "schedule": "0 2 * * 0"
    }
  ]
}
